{
  "version": 1,
  "profile": "light-keynote-production",
  "minimum_resolution": {
    "16:9": [1920, 1080],
    "9:16": [1080, 1920],
    "4:5": [1080, 1350],
    "3:4": [1080, 1440],
    "1:1": [1080, 1080],
    "4:3": [1440, 1080]
  },
  "preferred_internal_scale": 2,
  "cursor_heavy_min_fps": 60,
  "h264": {
    "preferred_crf_min": 17,
    "preferred_crf_max": 20,
    "hard_bitrate_floor_mbps_30fps": 5,
    "hard_bitrate_floor_mbps_60fps": 8
  },
  "typography": {
    "hard_min_effective_font_px": 22,
    "warn_min_effective_font_px": 28
  },
  "attention": {
    "warn_circle_events_per_minute": 3,
    "fail_circle_events_per_minute": 6,
    "warn_cursor_occlusion_ratio": 0.08,
    "fail_cursor_occlusion_ratio": 0.15
  },
  "transitions": {
    "warn_crossfade_only_ratio": 0.5,
    "fail_crossfade_only_ratio": 0.8,
    "warn_shared_element_use_ratio": 0.25
  },
  "review": {
    "contact_sheet_required": true,
    "motion_samples_required_over_seconds": 30,
    "transition_samples_required_when_transitions_exist": true
  }
}
